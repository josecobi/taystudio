---
import { getLangFromUrl } from '../../i18n/utils';
import SuccessMessage from '../../components/SuccessMessage.astro';
import QuoteFormSection from '../../components/QuoteFormSection.astro';

const lang = getLangFromUrl(Astro.url);
const success = Astro.url.searchParams.get('success');
---

<SuccessMessage show={!!success} />
<QuoteFormSection redirectUrl={`${Astro.url.origin}/${lang}/#contact?success=true`} />
