---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl } from '../../i18n/utils';
import SuccessMessage from '../../components/SuccessMessage.astro';
import QuoteFormSection from '../../components/QuoteFormSection.astro';

const lang = getLangFromUrl(Astro.url);
const success = Astro.url.searchParams.get('success');
---

<Layout
  title="Get a Quote | Tay Music Studio"
  description="Get a personalized quote for your music project. Contact us for composition, scoring, performing, producing, and audio design services."
  language={lang}
>
  <main class="mt-20 bg-paperCream min-h-screen">
    <SuccessMessage show={!!success} />
    <QuoteFormSection redirectUrl={`${Astro.url.origin}/${lang}/GetQuote?success=true`} />
  </main>
</Layout>